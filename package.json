{
  "name": "kakeibo-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-legal.mjs && tsc -b && vite build",
    "legal:build": "node scripts/build-legal.mjs",
    "legal:check": "node scripts/verify-legal.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "preview": "vite preview",
    "native:build": "node scripts/build-native-web.mjs",
    "native:sync": "npm run native:build && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/app": "7.1.2",
    "@capacitor/browser": "7.0.5",
    "@capacitor/core": "7.6.9",
    "@capacitor/filesystem": "7.1.9",
    "@capacitor/ios": "7.6.9",
    "@capacitor/local-notifications": "7.0.7",
    "@capacitor/share": "7.0.4",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "7.3.1",
    "@mui/material": "7.3.1",
    "dexie": "^4.0.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.9",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^1.3.0"
  },
  "overrides": {
    "react-is": "$react-is"
  }
}
